-- Hanya ada di server (ServerScriptService). Identitas staff = UserId, bukan nama.
return {
	ByUserId = {
		[8269411613] = "founder", -- bijibapakmuuuu
		[11411678988] = "founder", -- asterveil_nr
		[9188969905] = "founder", -- villainxxss
